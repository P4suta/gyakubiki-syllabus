{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --host 127.0.0.1 --port 4517 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "check": "bun run check:version && bun run check:workflow-policy && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:version": "bun scripts/check-version-drift.ts",
    "check:workflow-policy": "bun scripts/check-workflow-policy.ts",
    "lint": "biome check .",
    "mutation": "stryker run",
    "playwright:install": "playwright install",
    "sbom": "bun scripts/generate-sbom.ts reports/web.cdx.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:lighthouse": "bun scripts/run-lighthouse.ts",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:production-html": "bun scripts/check-production-html.ts",
    "test:perf": "bun scripts/check-search-performance.ts public"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.11",
    "@iconify-json/ic": "^1.2.4",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "^4.9.0",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^30.0.1",
    "lighthouse": "13.4.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "~7.0.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "brotli-dec-wasm": "2.3.2",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "postcss": "8.5.23",
    "qs": "6.15.3"
  }
}
